    <!-- Onboarding -->
    <string name="onboarding_step1_title">O que são códigos QR?</string>
    <string name="onboarding_step1_desc">Códigos QR são pequenos padrões quadrados encontrados em produtos, cardápios de restaurantes, cartazes e ingressos. Eles contêm informações úteis como links de sites, números de telefone ou texto.</string>
    <string name="onboarding_step2_title">Como escanear</string>
    <string name="onboarding_step2_desc">Aponte sua câmera para um código QR ou código de barras. O aplicativo lê automaticamente e mostra o conteúdo. Depois você pode abrir links, copiar texto ou ligar para números.</string>
    <string name="onboarding_step3_title">Escanear de fotos</string>
    <string name="onboarding_step3_desc">Você também pode escanear códigos QR de fotos salvas no seu celular. Toque no ícone de foto na tela da câmera para escolher uma imagem da galeria.</string>
