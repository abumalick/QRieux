    <!-- Onboarding -->
    <string name="onboarding_step1_title">QRコードとは？</string>
    <string name="onboarding_step1_desc">QRコードは商品、レストランのメニュー、ポスター、チケットなどにある小さな四角い模様です。ウェブサイトのリンク、電話番号、テキストなどの便利な情報が含まれています。</string>
    <string name="onboarding_step2_title">スキャン方法</string>
    <string name="onboarding_step2_desc">カメラをQRコードやバーコードに向けてください。アプリが自動的に読み取り、内容を表示します。リンクを開いたり、テキストをコピーしたり、電話をかけたりできます。</string>
    <string name="onboarding_step3_title">写真からスキャン</string>
    <string name="onboarding_step3_desc">スマホに保存した写真からもQRコードをスキャンできます。カメラ画面の写真アイコンをタップして、ギャラリーから画像を選んでください。</string>
    <string name="onboarding_next">次へ</string>
    <string name="onboarding_get_started">はじめる</string>
    <string name="onboarding_skip">スキップ</string>
    <string name="help">ヘルプ</string>

    <!--  Onboarding Step 4 -->
    <string name="onboarding_step4_title">QRコードを作成・共有</string>
    <string name="onboarding_step4_desc">ウェブサイト、連絡先、WiFiなどのQRコードを作成できます。誰とでも簡単に共有できます。</string>

    <!--  Tab Bar -->
    <string name="tab_scan">スキャン</string>
    <string name="tab_create">作成</string>
    <string name="tab_help">ヘルプ</string>

    <!--  Help Screen -->
    <string name="help_screen_title">QRieuxの使い方</string>
    <string name="help_flash_title">フラッシュの使い方</string>
    <string name="help_flash_desc">暗くてスキャンしにくい場合は、カメラ画面のフラッシュボタンをタップしてください。スマホのライトが点灯してQRコードが読み取りやすくなります。</string>
    <string name="help_share_to_scan_title">他のアプリからスキャン</string>
    <string name="help_share_to_scan_desc">他のアプリの写真をQRieuxに共有して、その中のQRコードをスキャンできます。ギャラリーやメッセージアプリで写真を開き、共有ボタンをタップしてQRieuxを選んでください。</string>
    <string name="help_wifi_contact_title">WiFiと連絡先のQRコード</string>
    <string name="help_wifi_contact_desc">WiFiの設定や連絡先情報が入ったQRコードがあります。スキャンすると、QRieuxからワンタップでWiFiに接続したり、その人を連絡先に追加したりできます。</string>
    <string name="help_share_to_create_title">共有してQRコードを作成</string>
    <string name="help_share_to_create_desc">他のアプリからウェブサイトのリンク、テキスト、または連絡先をQRieuxに共有すると、自動でQRコードを作成します。共有ボタンをタップしてQRieuxを選ぶだけです。</string>
    <string name="help_history_title">履歴</string>
    <string name="help_history_desc">履歴タブには、スキャンまたは作成したすべてのQRコードが記録されています。項目をタップすると詳細を確認できます。左にスワイプすると削除できます。</string>
    <string name="help_supported_formats_title">対応フォーマット</string>
    <string name="help_supported_formats_desc">QRコード、EAN-8、EAN-13、Code 128、Code 39、Code 93、UPC-E、PDF417、Aztec、Data Matrix。</string>
    <string name="navigate_back">戻る</string>
</resources>
