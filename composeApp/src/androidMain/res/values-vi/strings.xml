    <!-- Onboarding -->
    <string name="onboarding_step1_title">Mã QR là gì?</string>
    <string name="onboarding_step1_desc">Mã QR là những hình vuông nhỏ có trên sản phẩm, thực đơn nhà hàng, áp phích và vé. Chúng chứa thông tin hữu ích như liên kết web, số điện thoại hoặc văn bản.</string>
    <string name="onboarding_step2_title">Cách quét</string>
    <string name="onboarding_step2_desc">Hướng camera vào mã QR hoặc mã vạch. Ứng dụng sẽ tự động đọc và hiển thị nội dung. Sau đó bạn có thể mở liên kết, sao chép văn bản hoặc gọi điện.</string>
    <string name="onboarding_step3_title">Quét từ ảnh</string>
    <string name="onboarding_step3_desc">Bạn cũng có thể quét mã QR từ ảnh đã lưu trên điện thoại. Nhấn vào biểu tượng ảnh trên màn hình camera để chọn ảnh từ thư viện.</string>
    <string name="onboarding_next">Tiếp theo</string>
    <string name="onboarding_get_started">Bắt đầu</string>
    <string name="onboarding_skip">Bỏ qua</string>
