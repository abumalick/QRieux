# Android lanes
platform :android do
  desc "Download existing metadata from Play Store"
  lane :download_metadata do
    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload metadata to Play Store"
  lane :upload_metadata do
    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Upload screenshots only"
  lane :upload_screenshots do
    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true
    )
  end

  desc "Upload bundle to internal testing track"
  lane :internal do
    supply(
      aab: "composeApp/build/outputs/bundle/release/composeApp-release.aab",
      track: "internal",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload bundle to alpha (closed testing) track"
  lane :alpha do
    supply(
      aab: "composeApp/build/outputs/bundle/release/composeApp-release.aab",
      track: "alpha",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Validate Play Store credentials"
  lane :validate_credentials do
    validate_play_store_json_key(
      json_key: "fastlane/play-store-credentials.json"
    )
  end
end

# iOS lanes
platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: "BA8JTQ35P3",
      issuer_id: "28ada9f3-83a2-4d95-aa1f-fd8360311595",
      key_filepath: "fastlane/AuthKey_BA8JTQ35P3.p8"
    )

    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build only (no upload)"
  lane :build do
    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Upload metadata to App Store Connect"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: "BA8JTQ35P3",
      issuer_id: "28ada9f3-83a2-4d95-aa1f-fd8360311595",
      key_filepath: "fastlane/AuthKey_BA8JTQ35P3.p8"
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true
    )
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    api_key = app_store_connect_api_key(
      key_id: "BA8JTQ35P3",
      issuer_id: "28ada9f3-83a2-4d95-aa1f-fd8360311595",
      key_filepath: "fastlane/AuthKey_BA8JTQ35P3.p8"
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true
    )
  end

  desc "Upload metadata and screenshots"
  lane :upload_all do
    api_key = app_store_connect_api_key(
      key_id: "BA8JTQ35P3",
      issuer_id: "28ada9f3-83a2-4d95-aa1f-fd8360311595",
      key_filepath: "fastlane/AuthKey_BA8JTQ35P3.p8"
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      force: true
    )
  end

  desc "Submit for App Store review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: "BA8JTQ35P3",
      issuer_id: "28ada9f3-83a2-4d95-aa1f-fd8360311595",
      key_filepath: "fastlane/AuthKey_BA8JTQ35P3.p8"
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      submit_for_review: true,
      automatic_release: false,
      force: true
    )
  end
end
