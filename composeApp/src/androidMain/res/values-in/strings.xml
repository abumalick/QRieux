    <!-- Onboarding -->
    <string name="onboarding_step1_title">Apa itu Kode QR?</string>
    <string name="onboarding_step1_desc">Kode QR adalah pola persegi kecil yang ada di produk, menu restoran, poster, dan tiket. Kode ini berisi informasi berguna seperti tautan situs web, nomor telepon, atau teks.</string>
    <string name="onboarding_step2_title">Cara Memindai</string>
    <string name="onboarding_step2_desc">Arahkan kamera ke kode QR atau barcode. Aplikasi akan membacanya secara otomatis dan menampilkan isinya. Anda kemudian bisa membuka tautan, menyalin teks, atau menelepon.</string>
    <string name="onboarding_step3_title">Pindai dari Foto</string>
    <string name="onboarding_step3_desc">Anda juga bisa memindai kode QR dari foto yang tersimpan di ponsel. Ketuk ikon foto di layar kamera untuk memilih gambar dari galeri.</string>
    <string name="onboarding_next">Berikutnya</string>
    <string name="onboarding_get_started">Mulai</string>
    <string name="onboarding_skip">Lewati</string>
