    <!-- Onboarding -->
    <string name="onboarding_step1_title">Qu\'est-ce qu\'un code QR ?</string>
    <string name="onboarding_step1_desc">Les codes QR sont de petits carrés que l\'on trouve sur les produits, les menus de restaurants, les affiches et les billets. Ils contiennent des informations utiles comme des liens, des numéros de téléphone ou du texte.</string>
    <string name="onboarding_step2_title">Comment scanner</string>
    <string name="onboarding_step2_desc">Dirigez votre caméra vers un code QR ou un code-barres. L\'application le lit automatiquement et vous montre son contenu. Vous pouvez ensuite ouvrir des liens, copier du texte ou appeler des numéros.</string>
    <string name="onboarding_step3_title">Scanner depuis vos photos</string>
    <string name="onboarding_step3_desc">Vous pouvez aussi scanner des codes QR depuis les photos enregistrées sur votre téléphone. Appuyez sur l\'icône photo sur l\'écran de la caméra pour choisir une image.</string>
    <string name="onboarding_next">Suivant</string>
    <string name="onboarding_get_started">Commencer</string>
    <string name="onboarding_skip">Passer</string>
    <string name="help">Aide</string>

    <!--  Onboarding Step 4 -->
    <string name="onboarding_step4_title">Créer et partager des codes QR</string>
    <string name="onboarding_step4_desc">Créez vos propres codes QR pour des sites web, des contacts, le WiFi et plus encore. Partagez-les facilement avec n\'importe qui.</string>

