    <!-- Onboarding -->
    <string name="onboarding_step1_title">QR कोड क्या हैं?</string>
    <string name="onboarding_step1_desc">QR कोड छोटे चौकोर पैटर्न होते हैं जो उत्पादों, रेस्तरां मेनू, पोस्टर और टिकटों पर मिलते हैं। इनमें वेबसाइट लिंक, फोन नंबर या टेक्स्ट जैसी उपयोगी जानकारी होती है।</string>
    <string name="onboarding_step2_title">कैसे स्कैन करें</string>
    <string name="onboarding_step2_desc">अपना कैमरा QR कोड या बारकोड की ओर करें। ऐप इसे अपने आप पढ़ लेगा और आपको दिखाएगा। फिर आप लिंक खोल सकते हैं, टेक्स्ट कॉपी कर सकते हैं या फोन कर सकते हैं।</string>
    <string name="onboarding_step3_title">फोटो से स्कैन करें</string>
    <string name="onboarding_step3_desc">आप अपने फोन में सेव फोटो से भी QR कोड स्कैन कर सकते हैं। कैमरा स्क्रीन पर फोटो आइकन दबाकर गैलरी से तस्वीर चुनें।</string>
